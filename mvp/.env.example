# Copy to mvp/.env (git-ignored) for docker compose.
# Earth Engine / Google Cloud project id (same one used by `earthengine authenticate`).
EE_PROJECT=your-project-id
# A globally unique GCS bucket used to stage Sentinel exports (created on first use).
EE_BUCKET=galileo-mvp-yourname
# Optional limits
MVP_MAX_AREA_KM2=9
MVP_BATCH_SIZE=256